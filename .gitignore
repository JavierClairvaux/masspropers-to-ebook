# bible_databases/ and divinum-officium/ are git submodules (see .gitmodules) —
# tracked as pinned commit references, not ignored.

# Generated output
/output/
/cache/

# Calibre-Web runtime state (db, sessions, credentials) — not source
/calibre-web/config/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# Secrets — never commit
auth.token
*.token

# Editor/OS cruft
.DS_Store
*.swp

# Leftover artifacts from setup
*.zip
